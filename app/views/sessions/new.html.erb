<div class="auth">
  <section class="auth-pitch">
    <div>
      <div class="brand"><span class="brand-mark"><%= icon :target, size: 18 %></span><span class="brand-name">Prumo</span></div>
      <h1>Projetos e produtos, no mesmo prumo.</h1>
    </div>
    <ul>
      <li>Quadro Kanban com arrastar e soltar</li>
      <li>Sprints, backlog e gráfico de burndown</li>
      <li>Roadmap de produtos e versões</li>
      <li>Documentação em páginas, com Markdown</li>
    </ul>
    <small>Projeto de portfólio. Dados fictícios de demonstração.</small>
  </section>

  <section class="auth-form">
    <div><h1>Entrar</h1><p class="muted">Use sua conta ou escolha um perfil de demonstração.</p></div>

    <%= form_with url: login_path, class: "stack" do |f| %>
      <div class="field"><%= f.label :email, "E-mail" %><%= f.email_field :email, value: params[:email], autocomplete: "email", required: true, autofocus: true %></div>
      <div class="field"><%= f.label :password, "Senha" %><%= f.password_field :password, autocomplete: "current-password", required: true %></div>
      <%= f.submit "Entrar", class: "btn" %>
    <% end %>

    <% if @demo_users&.any? %>
      <div class="stack">
        <p class="small"><strong>Demonstração:</strong> entre com um clique (senha de todos: <span class="mono">prumo123</span>)</p>
        <div class="demo-list">
          <% @demo_users.each do |u| %>
            <%= button_to demo_login_path(u), class: "demo-user", form: { class: "inline" } do %>
              <%= avatar u, size: 28 %><span><strong><%= u.name %></strong><br><small><%= u.job_title %></small></span><small><%= enum_label(:user, :role, u.role) %></small>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
