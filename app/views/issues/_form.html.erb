<%= form_with model: issue, url: project_issues_path(project) do |f| %>
  <% if issue.errors.any? %><div class="errors"><strong>Não foi possível salvar:</strong><ul><% issue.errors.full_messages.each { |m| concat tag.li(m) } %></ul></div><% end %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <div class="form-grid">
    <div class="field c6"><%= f.label :title %><%= f.text_field :title, required: true, autofocus: true, maxlength: 200 %></div>
    <div class="field c6"><%= f.label :description %><%= f.text_area :description, rows: 6, placeholder: "Contexto, critérios de aceite… (aceita Markdown)" %></div>
    <div class="field c2"><%= f.label :kind %><%= f.select :kind, Issue::KINDS.map { |s| [enum_label(:issue, :kind, s), s] } %></div>
    <div class="field c2"><%= f.label :priority %><%= f.select :priority, Issue::PRIORITIES.map { |s| [enum_label(:issue, :priority, s), s] }, selected: issue.priority %></div>
    <div class="field c2"><%= f.label :estimate %><%= f.select :estimate, Issue::ESTIMATES, include_blank: "Sem estimativa" %></div>
    <div class="field c2"><%= f.label :status %><%= f.select :status, Issue::STATUSES.map { |s| [enum_label(:issue, :status, s), s] } %></div>
    <div class="field c2"><%= f.label :assignee_id, "Responsável" %><%= f.collection_select :assignee_id, members, :id, :name, include_blank: "Sem responsável" %></div>
    <div class="field c2"><%= f.label :sprint_id, "Sprint" %><%= f.collection_select :sprint_id, sprints, :id, :name, include_blank: "Backlog" %></div>
    <div class="field c2"><%= f.label :parent_id, "Épico" %><%= f.collection_select :parent_id, epics, :id, :title, include_blank: "Nenhum" %></div>
    <div class="field c2"><%= f.label :start_date %><%= f.date_field :start_date %></div>
    <div class="field c2"><%= f.label :due_date %><%= f.date_field :due_date %></div>
    <% if releases.any? %><div class="field c3"><%= f.label :release_id, "Versão" %><%= f.collection_select :release_id, releases, :id, :name, include_blank: "Nenhuma" %></div><% end %>
    <div class="field c3"><%= f.label :labels_text, "Etiquetas" %><%= f.text_field :labels_text, placeholder: "separe por vírgula" %></div>
  </div>
  <div class="form-actions"><%= link_to "Cancelar", board_project_path(project), class: "btn btn-ghost" %><%= f.submit "Criar tarefa", class: "btn" %></div>
<% end %>
