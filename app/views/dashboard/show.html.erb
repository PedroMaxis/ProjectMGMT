<% content_for :title, "Painel" %>
<% content_for :crumbs do %><strong>Painel</strong><% end %>

<% abertas = @by_status.except("done").values.sum %>
<% semana = Issue.work.done.where("completed_at >= ?", Time.current.beginning_of_week).count %>

<div class="page-head">
  <div>
    <h1>Olá, <%= current_user.first_name %></h1>
    <p><%= l(Date.current, format: "%A, %d de %B").capitalize %> · <%= pluralize(@my_issues.size, "tarefa") %> para você hoje.</p>
  </div>
  <% if can_edit? %><%= link_to new_project_path, class: "btn" do %><%= icon :plus, size: 16 %> Novo projeto<% end %><% end %>
</div>

<div class="stats">
  <div class="card stat"><span class="ico"><%= icon :folder %></span><div><strong><%= @projects.count { |p| p.status == "active" } %></strong><span>Projetos em andamento</span></div></div>
  <div class="card stat"><span class="ico"><%= icon :list %></span><div><strong><%= abertas %></strong><span>Tarefas abertas</span></div></div>
  <div class="card stat"><span class="ico ok"><%= icon :check %></span><div><strong><%= semana %></strong><span>Concluídas esta semana</span></div></div>
  <div class="card stat"><span class="ico <%= @overdue.any? ? 'danger' : 'ok' %>"><%= icon :alert %></span><div><strong><%= Issue.work.overdue.count %></strong><span>Tarefas atrasadas</span></div></div>
</div>

<div class="grid-2">
  <div class="stack">
    <section class="card">
      <header><h2>Meu trabalho</h2><small>por prazo</small></header>
      <% if @my_issues.any? %>
        <ul class="list">
          <% @my_issues.each do |i| %>
            <li>
              <%= kind_icon i.kind %>
              <span class="mono small"><%= i.key %></span>
              <%= link_to i.title, issue_path(i), class: "title grow truncate" %>
              <%= status_chip i.status %><%= due_label i %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty small"><p>Nada atribuído a você. Bom momento para pegar algo no backlog.</p></div>
      <% end %>
    </section>

    <section class="card">
      <header><h2>Saúde dos projetos</h2><%= link_to "Ver todos", projects_path, class: "link small" %></header>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Projeto</th><th>Líder</th><th>Andamento</th><th>Prazo</th><th>Saúde</th></tr></thead>
          <tbody>
            <% @projects.each do |p| %>
              <tr>
                <td><%= link_to project_path(p), class: "row" do %><i class="dot" style="<%= project_color_style(p) %>"></i><strong><%= p.name %></strong><% end %></td>
                <td><%= avatar p.lead, size: 24 %></td>
                <td style="min-width:130px"><div class="row"><div class="grow"><%= progress_bar p.progress %></div><small class="num"><%= p.progress %>%</small></div></td>
                <td class="num"><%= short_date p.due_date %></td>
                <td><%= health_badge p %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <header><h2>Atividade recente</h2></header>
      <ul class="list">
        <% @events.each do |e| %>
          <li style="align-items:flex-start">
            <%= avatar e.user, size: 24 %>
            <div class="grow small" style="color:var(--text)">
              <strong><%= e.user&.first_name %></strong> <%= event_text(e) %>
              <% if e.issue %><%= link_to e.issue.key, issue_path(e.issue), class: "link mono" %><% end %>
              <br><small><%= ago e.created_at %></small>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  </div>

  <div class="stack">
    <section class="card">
      <header><h2>Sprints ativas</h2></header>
      <% if @sprints.any? %>
        <ul class="list">
          <% @sprints.each do |s| %>
            <li style="align-items:flex-start">
              <i class="dot" style="<%= project_color_style(s.project) %>; margin-top:6px"></i>
              <div class="grow">
                <%= link_to board_project_path(s.project), class: "title" do %><strong><%= s.project.key %> · <%= s.name %></strong><% end %>
                <p class="small"><%= s.goal %></p>
                <% pct = s.total_points.zero? ? 0 : (s.done_points * 100.0 / s.total_points).round %>
                <div class="row" style="margin-top:6px"><div class="grow"><%= progress_bar pct, tone: :ok %></div><small class="num"><%= s.done_points %>/<%= s.total_points %> pts</small></div>
                <small>termina em <%= short_date s.end_date %> · <%= (s.end_date - Date.current).to_i.clamp(0, 999) %> dias</small>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="empty small"><p>Nenhuma sprint ativa.</p></div>
      <% end %>
    </section>

    <section class="card">
      <header><h2>Distribuição das tarefas</h2></header>
      <div class="card-body donut-wrap">
        <%= donut_chart status_segments(@by_status), center: @by_status.values.sum %>
        <ul class="legend grow">
          <% status_segments(@by_status).each do |s| %><li><i style="background: <%= s[:color] %>"></i><%= s[:label] %><b><%= s[:value] %></b></li><% end %>
        </ul>
      </div>
    </section>

    <section class="card">
      <header><h2>Carga da equipe</h2><small>pontos em aberto</small></header>
      <div class="card-body hbars">
        <% max = [@workload.values.max.to_i, 1].max %>
        <% @workload.sort_by { |_, v| -v }.each do |uid, pts| %>
          <div class="hbar"><span class="row"><%= avatar @people[uid], size: 22 %><span class="truncate"><%= @people[uid]&.first_name %></span></span><div class="track"><i style="width: <%= pts * 100 / max %>%"></i></div><b><%= pts %></b></div>
        <% end %>
      </div>
    </section>
  </div>
</div>
