<% content_for :title, "Cronograma · #{@project.name}" %>
<%= render "shared/project_header", project: @project, current: "Cronograma" %>

<section class="card gantt">
  <div class="gantt-inner">
    <div class="gantt-head"><% month_ticks(@range).each do |d, pct| %><span style="left: <%= pct %>%"><%= l(d, format: "%b/%y") %></span><% end %></div>
    <div class="gantt-grid"><% month_ticks(@range).each do |_, pct| %><i style="left: <%= pct %>%"></i><% end %></div>
    <% if @range.cover?(Date.current) %><div class="gantt-today" style="left: calc(220px + (100% - 220px) * <%= pct_in(@range, Date.current) / 100.0 %>)"><span>hoje</span></div><% end %>

    <% barra = ->(ini, fim) { l = pct_in(@range, ini); w = [pct_in(@range, fim) - l, 0.8].max; "left: #{l}%; width: #{w}%" } %>

    <div class="gantt-row"><div class="gantt-label group"><strong><%= @project.name %></strong><small>projeto</small></div>
      <div class="gantt-track"><div class="gantt-bar" style="<%= barra.(@project.start_date, @project.due_date) %>; <%= project_color_style(@project) %>"><div class="fill" style="width: <%= @project.progress %>%"></div><span><%= @project.progress %>%</span></div></div></div>

    <% if @sprints.any? %>
      <div class="gantt-row"><div class="gantt-label group"><strong>Sprints</strong></div><div class="gantt-track"></div></div>
      <% @sprints.each do |s| %>
        <div class="gantt-row"><div class="gantt-label"><strong><%= s.name %></strong><small><%= enum_label(:sprint, :status, s.status) %></small></div>
          <div class="gantt-track"><div class="gantt-bar" style="<%= barra.(s.start_date, s.end_date) %>; --pc: <%= s.active? ? 'var(--ok)' : (s.completed? ? 'var(--faint)' : 'var(--accent)') %>"><span><%= s.name %></span></div></div></div>
      <% end %>
    <% end %>

    <% if @epics.any? %>
      <div class="gantt-row"><div class="gantt-label group"><strong>Épicos</strong></div><div class="gantt-track"></div></div>
      <% @epics.each do |e| %>
        <% filhos = e.children; pct = filhos.empty? ? 0 : filhos.count(&:done?) * 100 / filhos.size %>
        <div class="gantt-row"><div class="gantt-label"><%= link_to e.title, issue_path(e), class: "title" %><small class="mono"><%= e.key %> · <%= pct %>%</small></div>
          <div class="gantt-track"><% if e.start_date && e.due_date %><div class="gantt-bar" style="<%= barra.(e.start_date, e.due_date) %>; --pc: #8b5cf6"><div class="fill" style="width: <%= pct %>%"></div><span><%= e.title %></span></div><% else %><small style="padding-left:12px">sem datas</small><% end %></div></div>
      <% end %>
    <% end %>

    <% if @milestones.any? %>
      <div class="gantt-row"><div class="gantt-label group"><strong>Marcos</strong></div><div class="gantt-track"></div></div>
      <% @milestones.each do |m| %>
        <div class="gantt-row"><div class="gantt-label"><strong><%= m.title %></strong><small><%= long_date m.due_date %></small></div><div class="gantt-track"><i class="gantt-pin <%= 'done' if m.completed? %>" style="left: <%= pct_in(@range, m.due_date) %>%" title="<%= m.title %>"></i></div></div>
      <% end %>
    <% end %>
  </div>
  <div class="timeline-legend"><span>Faixa escura = parte concluída</span><span>Linha vermelha = hoje</span><span>Losango = marco</span></div>
</section>
