<%= form_with model: project do |f| %>
  <% if project.errors.any? %>
    <div class="errors"><strong>Não foi possível salvar:</strong><ul><% project.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div class="form-grid">
    <div class="field c4"><%= f.label :name %><%= f.text_field :name, required: true, autofocus: true %></div>
    <div class="field c2"><%= f.label :key %><%= f.text_field :key, maxlength: 6, style: "text-transform: uppercase", placeholder: "WEB" %><span class="hint">Prefixo das tarefas (WEB-12)</span></div>
    <div class="field c6"><%= f.label :description %><%= f.text_area :description, rows: 3 %></div>
    <div class="field c2"><%= f.label :start_date %><%= f.date_field :start_date, required: true %></div>
    <div class="field c2"><%= f.label :due_date %><%= f.date_field :due_date, required: true %></div>
    <div class="field c2"><%= f.label :color, "Cor" %><%= f.color_field :color %></div>
    <div class="field c2"><%= f.label :status %><%= f.select :status, Project::STATUSES.map { |s| [enum_label(:project, :status, s), s] } %></div>
    <div class="field c2"><%= f.label :priority %><%= f.select :priority, Project::PRIORITIES.map { |s| [enum_label(:project, :priority, s), s] } %></div>
    <div class="field c2"><%= f.label :lead_id, "Líder" %><%= f.collection_select :lead_id, User.alphabetical, :id, :name, include_blank: "Sem líder" %></div>
    <div class="field c3"><%= f.label :product_id, "Produto" %><%= f.collection_select :product_id, Product.visible.order(:name), :id, :name, include_blank: "Sem produto" %></div>
  </div>
  <div class="form-actions">
    <%= link_to "Cancelar", (project.persisted? ? project_path(project) : projects_path), class: "btn btn-ghost" %>
    <%= f.submit (project.persisted? ? "Salvar projeto" : "Criar projeto"), class: "btn" %>
  </div>
<% end %>
